{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "Day.schema.json",
  "title": "temporal.day",
  "description": "Day rollup node on the chronological spine",
  "type": "object",
  "required": [
    "type",
    "title",
    "period",
    "status"
  ],
  "properties": {
    "type": {
      "const": "temporal.day"
    },
    "title": {
      "type": "string"
    },
    "period": {
      "type": "string"
    },
    "start_date": {
      "type": "string"
    },
    "end_date": {
      "type": "string"
    },
    "status": {
      "enum": [
        "open",
        "segmented",
        "finalized"
      ]
    },
    "aggregates": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "author": {
      "type": "string"
    },
    "timestamp": {
      "type": "string"
    }
  }
}
