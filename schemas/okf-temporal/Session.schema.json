{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "Session.schema.json",
  "title": "temporal.session",
  "description": "Session hub. Identity resolves to AgentIdentity; this schema does not define a new identity type. Segments are hour-aligned triples; the tick gates on segment status, not session status.",
  "type": "object",
  "required": [
    "type",
    "id",
    "agent",
    "status"
  ],
  "properties": {
    "type": {
      "const": "temporal.session"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9_]+__[a-z0-9_]+__[0-9]{3}$"
    },
    "ulid": {
      "type": "string",
      "minLength": 26,
      "maxLength": 26
    },
    "agent": {
      "type": "object",
      "required": [
        "name",
        "role"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "role": {
          "type": "string"
        },
        "machine": {
          "type": "string"
        }
      }
    },
    "started_at": {
      "type": "string"
    },
    "ended_at": {
      "type": "string"
    },
    "close_reason": {
      "enum": [
        "clear",
        "compact",
        "user",
        "watchdog"
      ]
    },
    "status": {
      "enum": [
        "open",
        "segmented",
        "finalized"
      ]
    },
    "parent": {
      "type": "string"
    },
    "segments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "index",
          "hour",
          "status"
        ],
        "properties": {
          "index": {
            "type": "integer",
            "minimum": 1
          },
          "hour": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}$",
            "description": "Hour period this segment belongs to. Replaces the earlier `period` key."
          },
          "status": {
            "enum": [
              "open",
              "closed"
            ]
          },
          "telemetry": {
            "type": "string",
            "description": "Optional even when closed. 90-day prune removes the raw telemetry file from the working tree while the segment stays closed. Absence of the key is not a validation error."
          },
          "summary": {
            "type": "string"
          },
          "saliency": {
            "type": "string"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "closed"
                }
              },
              "required": [
                "status"
              ]
            },
            "then": {
              "required": [
                "summary",
                "saliency"
              ]
            }
          }
        ]
      }
    },
    "author": {
      "type": "string"
    },
    "timestamp": {
      "type": "string"
    },
    "title": {
      "type": "string"
    }
  }
}
